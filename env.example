# Authentication (Required for NextAuth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-generated-nextauth-secret # Generate with: openssl rand -base64 32

# Database (Required for MongoDB connection)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/safeplate?retryWrites=true&w=majority

# Security (Optional - for rate limiting and advanced security features)
MAX_REQUESTS_PER_IP=100
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes

# Application Settings (Optional)
NODE_ENV=development # development or production
API_URL=http://localhost:3000/api

# Email Settings (Optional - for future password reset functionality)
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-email@example.com
EMAIL_SERVER_PASSWORD=your-email-password
EMAIL_FROM=noreply@example.com

# Feature Flags (Optional)
ENABLE_USER_REGISTRATION=true
ENABLE_SOCIAL_AUTH=false
ENABLE_EMAIL_VERIFICATION=false

# Logging (Optional)
LOG_LEVEL=info # debug, info, warn, or error

# AI Services
GEMINI_API_KEY=your-gemini-api-key